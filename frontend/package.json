{
    "name": "goaltracker-frontend",
    "version": "1.0.0",
    "description": "Real-time goal tracking frontend",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "cap:init": "npx cap init",
        "cap:add:android": "npx cap add android",
        "cap:add:ios": "npx cap add ios",
        "cap:sync": "npm run build && npx cap sync",
        "cap:sync:android": "npm run build && npx cap sync android",
        "cap:sync:ios": "npm run build && npx cap sync ios",
        "cap:open:android": "npx cap open android",
        "cap:open:ios": "npx cap open ios",
        "cap:run:android": "npm run cap:sync:android && npx cap open android",
        "cap:run:ios": "npm run cap:sync:ios && npx cap open ios"
    },
    "dependencies": {
        "@capacitor/android": "^8.0.0",
        "@capacitor/cli": "^8.0.0",
        "@capacitor/core": "^8.0.0",
        "@capacitor/haptics": "^8.0.0",
        "@capacitor/push-notifications": "^8.0.0",
        "axios": "^1.6.2",
        "canvas-confetti": "^1.9.4",
        "chart.js": "^4.4.1",
        "date-fns": "^3.0.6",
        "framer-motion": "^12.25.0",
        "react": "^18.2.0",
        "react-chartjs-2": "^5.2.0",
        "react-dom": "^18.2.0",
        "react-hot-toast": "^2.6.0",
        "react-loading-skeleton": "^3.5.0",
        "react-router-dom": "^6.21.0",
        "socket.io-client": "^4.6.1"
    },
    "devDependencies": {
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "vite": "^5.0.8"
    }
}
