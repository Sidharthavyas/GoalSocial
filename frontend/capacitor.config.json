{
  "appId": "com.gosocial.app",
  "appName": "GoSocial",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://goal-social.vercel.app",
    "allowNavigation": [
      "goal-social.vercel.app",
      "goalsocial-1.onrender.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a0a",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
